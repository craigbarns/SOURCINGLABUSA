# All variables in this file are server-only.
# Never add the NEXT_PUBLIC_ prefix to a secret.

# Trusted origins used by routing and metadata.
# These values are public by nature but remain server-configured.
MARKETING_ORIGIN=https://sourcinglabusa.com
APP_ORIGIN=https://app.sourcinglabusa.com

# Quote OCR. Without a key, the analyzer returns an explicitly labeled demo.
MISTRAL_API_KEY=
# Optional: leave empty to use the server default.
MISTRAL_OCR_MODEL=

# Structured extraction and AI-assisted analysis.
OPENAI_API_KEY=
# Optional: leave empty to use the server default.
OPENAI_MODEL=

# Server-only Supabase access for product-update registrations and for the
# durable storage of inbound project briefs (table public.project_briefs).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Image generation for the product visuals (scripts/generate-product-images.mjs).
# Only used by that script, never by the application at runtime.
FAL_KEY=
# Optional: override the fal.ai model used to generate product images.
FAL_IMAGE_MODEL=
