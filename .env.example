# Toutes ces variables sont réservées au serveur.
# Ne leur ajoutez jamais le préfixe NEXT_PUBLIC_.

# OCR de devis. Sans clé, l'analyse doit annoncer explicitement le mode démo.
MISTRAL_API_KEY=
# Optionnel : le serveur utilise son modèle OCR par défaut si cette valeur est vide.
MISTRAL_OCR_MODEL=

# Analyse structurée du texte OCR.
OPENAI_API_KEY=
# Optionnel : le serveur utilise son modèle par défaut si cette valeur est vide.
OPENAI_MODEL=

# Accès Supabase côté serveur uniquement.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
